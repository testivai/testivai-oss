{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // Replaces the "node" (node10) resolver, which TypeScript 7 removed.
    // "bundler" is the only resolver TS 7 still allows alongside
    // "module": "commonjs", so emit stays CJS — dynamic import() keeps
    // downlevelling to require() — and relative imports need no extensions.
    // It also honours package.json "exports", which node10 ignored.
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
