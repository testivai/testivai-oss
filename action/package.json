{
  "name": "testivai-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action to post TestivAI visual regression results to PRs",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testivai/testivai-oss.git",
    "directory": "action"
  },
  "bugs": {
    "url": "https://github.com/testivai/testivai-oss/issues"
  },
  "homepage": "https://github.com/testivai/testivai-oss/tree/main/action#readme",
  "keywords": [
