exports[`publishSummary when nothing was published Pages builds from a branch: the reason, with the admin instruction, on the run page 1`] = `
"### TestivAI reports not published

GitHub Pages here builds from a branch\\, so reports are not published\\. An admin can set Settings → Pages → Source to \\"GitHub Actions\\" for TestivAI to publish them\\.
"
`;

exports[`publishSummary when nothing was published Pages is off: the reason, with the admin instruction, on the run page 1`] = `
"### TestivAI reports not published

GitHub Pages is not enabled for this repository\\, so reports are not published\\; the PR comment keeps the report ZIP\\. An admin can enable it under Settings → Pages\\, with the source \\"GitHub Actions\\"\\.
"
`;

exports[`publishSummary when nothing was published a private repository with a public site: the reason, with the admin instruction, on the run page 1`] = `
"### TestivAI reports not published

This repository is private but its GitHub Pages site is public\\, so published reports \\(screenshots included\\) would be readable by anyone on the internet\\. Reports are not published\\. An admin can allow it by setting the variable TESTIVAI\\_PUBLIC\\_REPORTS\\=true on the github\\-pages environment \\(Settings → Environments → github\\-pages\\)\\, or make the site private \\(GitHub Enterprise Cloud\\: Settings → Pages → Visibility\\)\\.
"
`;
