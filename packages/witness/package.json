{
  "name": "@testivai/witness",
  "version": "2.0.2",
  "description": "Local-first visual regression testing: CLI, diff engine, baselines and self-contained HTML report. No account, nothing uploaded.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "default": "./dist/diff/index.js"
    },
    "./baselines": {
      "types": "./dist/baselines/index.d.ts",
      "default": "./dist/baselines/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "default": "./dist/report/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "diff": [
        "dist/diff/index.d.ts"
      ],
      "baselines": [
        "dist/baselines/index.d.ts"
      ],
      "config": [
        "dist/config/index.d.ts"
      ],
      "report": [
        "dist/report/index.d.ts"
      ]
    }
  },
  "bin": {
    "testivai": "./dist/bin/testivai.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "testivai",
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "regression-testing",
    "test-automation",
    "cli",
    "framework-agnostic",
    "selenium",
    "webdriverio",
    "cypress",
    "puppeteer"
  ],
  "author": "TestivAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testivai/testivai-oss.git",
    "directory": "packages/witness"
  },
  "bugs": {
    "url": "https://github.com/testivai/testivai-oss/issues"
  },
  "homepage": "https://github.com/testivai/testivai-oss/tree/main/packages/witness#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^14.0.3",
    "inquirer": "^8.2.6",
    "ora": "^9.4.1",
    "pngjs": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
